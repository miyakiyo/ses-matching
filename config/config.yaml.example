# Azure AD認証情報
azure:
  client_id: *****************
  client_secret: *****************
  tenant_id: *****************

# メールボックス情報
mailbox:
  shared_mailbox: sales@offgrid.co.jp
  not_folder: []  # 除外フォルダリスト（例: [Documents, Archive]）
  not_folder_keywords: [迷惑メール, 送信トレイ, 送信済みアイテム, 削除済みアイテム, 三松システムコンサルティング, レンサ, ラグナロク, ユーフォノーツ, マイラップ, ブライトスター, ドリームビジョン, テックリーチ, クロニクル, グラントホープ, キャリアビート, エンジニアのミカタ, エル・フィールド, イチアール]  # フォルダ名が完全一致したら除外（例: ["削除済みアイテム", "通知"]）
  lm_exclude_folders_talent: [三松システムコンサルティング, レンサ, ラグナロク, ユーフォノーツ, マイラップ, ブライトスター, ドリームビジョン, テックリーチ, クロニクル, グラントホープ, キャリアビート, エンジニアのミカタ, エル・フィールド, イチアール]  # LM後処理(人材)の対象から除外するフォルダ名（完全一致）
  lm_exclude_folders_project: [三松システムコンサルティング, レンサ, ラグナロク, ユーフォノーツ, マイラップ, ブライトスター, ドリームビジョン, テックリーチ, クロニクル, グラントホープ, キャリアビート, エンジニアのミカタ, エル・フィールド, イチアール]  # LM後処理(案件)の対象から除外するフォルダ名（完全一致）
  db_path: DB/mails.db

# 処理実行フラグ（CLI未指定時に適用、CLI指定時はCLIを優先）
processes:
  mail_fetch: true
  lm_postprocess_talent: true
  lm_postprocess_project: true
  matching: true
  delete_old: true
  csv_export: true

# SES分類キーワード
ses:
  project_keywords: [案件, 募集, 急募, 増員, 交代枠, エンド直, 元請直, 現場直, 参画予定, 参画中, 【ARI】]
  talent_keywords: [人材, 要員, プロパー,技術者, 要員, 弊社所属, エンジニア, 稼働可能, 参画可能, 待機, 空き, フリーランス, 即戦力, 個人事業主, 正社員, 懇意BP, 歳]
  unclassified_log_path: logs/unclassified.log
  log_path: "logs/app.log"

# LM Studio 設定
lmstudio:
  endpoint: http://localhost:1234/v1/chat/completions
  model: Qwen2.5-7B-Instruct-GGUF
  timeout: 60
  max_tokens: 4096
  limit_per_table_talent: 500
  limit_per_table_project: 500
  num_workers: 4
  signature_trim_chars: 300
  greeting_trim_chars: 100
