{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SES案件情報",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "分類": {
        "type": "string",
        "enum": ["案件"]
      },
      "リモート頻度": {
        "type": "string",
        "description": "例: フルリモート/週2出社/基本出社 など"
      },
      "必須スキル": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "例: 上流工程, 要件定義, 基本設計, Java, Python, TypeScript など。担当/工程/開発言語/データベース/OS/クラウドの元データとしても利用する。"
      },
      "尚可スキル": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "例: 上流工程, 要件定義, 基本設計, Java, Python, TypeScript など"
      },
      "担当": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "必須スキルから担当ロールに該当するものを入れる（例: メンバー, テスト, リーダー, PM, PMO）"
      },
      "工程": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "必須スキルから工程に該当するものを入れる（例: 要件定義/基本設計/詳細設計/開発/テスト/運用保守）"
      },
      "開発言語": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "必須スキルから開発言語に該当するものを入れる（例: Java, Python, TypeScript, COBOL）"
      },
      "データベース": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "必須スキルからデータベースに該当するものを入れる（例: MySQL, PostgreSQL, MongoDB）"
      },
      "OS/クラウド": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "必須スキルからOS/クラウドに該当するものを入れる（例: AWS, Azure, GCP）"
      },
      "単価下限": {
        "type": ["number", "null"],
        "minimum": 0,
        "description": "単価下限（数値）。制限がない場合は null"
      },
      "単価上限": {
        "type": ["number", "null"],
        "minimum": 0,
        "description": "単価上限（数値）。制限がない場合は null"
      },
      "年齢下限": {
        "type": ["integer", "null"],
        "minimum": 0,
        "maximum": 120,
        "description": "年齢下限（数値）。制限がない場合は null"
      },
      "年齢上限": {
        "type": ["integer", "null"],
        "minimum": 0,
        "maximum": 120,
        "description": "年齢上限（数値）。制限がない場合は null"
      },
      "外国籍可否": {
        "type": "boolean",
        "description": "true=可 / false=不可"
      },
      "個人事業主可否": {
        "type": "boolean",
        "description": "true=可 / false=不可"
      },
      "契約形態": {
        "type": "string",
        "enum": [
          "準委任",
          "派遣",
          "請負",
          "その他"
        ],
        "description": "必要なら選択肢を増減してください"
      },
      "商流制限_貴社所属迄": {
        "type": "boolean"
      },
      "商流制限_営業支援費可": {
        "type": "boolean"
      },
      "商流制限_浅い方優先": {
        "type": "boolean"
      }
    }
  }
}